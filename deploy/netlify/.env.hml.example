# URL publica e estavel fornecida pelo Netlify.
# Este e o unico lugar que deve ser alterado quando o dominio mudar.
SITE_URL=https://nome-do-site.netlify.app

# Supabase Cloud > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente no servidor. Nunca use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SECRET_KEY=

# Gere valores independentes, aleatorios e com pelo menos 32 caracteres.
AUTH_RATE_LIMIT_SECRET=
LEAD_RATE_LIMIT_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

